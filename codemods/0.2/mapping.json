{
  "$comment": "What the 0.1 -> 0.2 codemods do with each 0.1 export. Read by codemods/0.2/*.mjs and by the tests. 'removed' exports move to their Astryx counterpart under @lablup/ui-common/<subpath>; 'kept' exports keep the import they had; 'moved' exports change subpath only.",
  "from": "0.1",
  "removed": {
    "Badge": {
      "to": "Badge",
      "subpath": "Badge",
      "types": { "BadgeProps": "BadgeProps" }
    },
    "BaseCard": {
      "to": "Card",
      "subpath": "Card",
      "alternates": { "ClickableCard": "ClickableCard" },
      "types": {
        "BaseCardProps": "CardProps",
        "BaseCardVariant": null,
        "BaseCardState": null
      }
    },
    "Button": {
      "to": "Button",
      "subpath": "Button",
      "types": { "ButtonProps": "ButtonProps" }
    },
    "DataTable": {
      "to": "Table",
      "subpath": "Table",
      "types": {
        "DataTableProps": "TableProps",
        "DataTableColumn": "TableColumn",
        "DataTablePersistedState": null,
        "SortDirection": null
      }
    },
    "Drawer": {
      "to": "Drawer",
      "subpath": "lab",
      "requiresPeer": "@astryxdesign/lab",
      "types": { "DrawerProps": "DrawerProps" }
    },
    "EmptyState": {
      "to": "EmptyState",
      "subpath": "EmptyState",
      "types": {
        "EmptyStateProps": "EmptyStateProps",
        "EmptyStateAction": null,
        "EmptyStateSecondaryAction": null
      }
    },
    "ProgressBar": {
      "to": "ProgressBar",
      "subpath": "ProgressBar",
      "types": {
        "ProgressBarProps": "ProgressBarProps",
        "ProgressBarVariant": "ProgressBarVariant",
        "ProgressBarSize": null
      }
    },
    "Select": {
      "to": "Selector",
      "subpath": "Selector",
      "types": {
        "SelectProps": "SelectorProps",
        "SelectOption": "SelectorOptionData"
      }
    },
    "Skeleton": {
      "to": "Skeleton",
      "subpath": "Skeleton",
      "types": { "SkeletonProps": "SkeletonProps" }
    },
    "StatusTag": {
      "to": "StatusDot",
      "subpath": "StatusDot",
      "types": { "StatusTagProps": "StatusDotProps", "StatusKind": null }
    },
    "Tabs": {
      "to": "TabList",
      "subpath": "TabList",
      "types": {
        "TabsProps": "TabListProps",
        "TabItem": null,
        "TabGroupMeta": null,
        "TabOverflowMode": null,
        "TabVariant": null
      }
    },
    "Tooltip": {
      "to": "Tooltip",
      "subpath": "Tooltip",
      "types": { "TooltipProps": "TooltipProps" }
    }
  },
  "kept": {
    "DigitPopIn": ["DigitPopIn", "DigitPopInProps"],
    "ErrorState": ["ErrorState", "ErrorStateProps", "ErrorTone", "ErrorAction"],
    "PageHeader": ["PageHeader", "PageHeaderProps"],
    "PageLayout": ["PageLayout", "PageLayoutProps", "PageLayoutVariant"],
    "Skeleton": [
      "SkeletonCard",
      "SkeletonCardProps",
      "SkeletonText",
      "SkeletonTextProps",
      "SkeletonChart",
      "SkeletonChartProps",
      "SkeletonRow",
      "SkeletonRowProps"
    ],
    "SmoothHeight": ["SmoothHeight", "SmoothHeightProps"],
    "StatCard": [
      "StatCard",
      "formatCompactNumber",
      "StatCardProps",
      "StatCardAnimation",
      "StatCardEmphasis",
      "StatCardTone",
      "StatCardTrend",
      "StatCardTrendDirection"
    ]
  },
  "moved": {
    "usePrefersReducedMotion": {
      "from": "hooks",
      "to": "",
      "reason": "@lablup/ui-common/hooks is Astryx's hooks barrel from 0.2; ui-common's own hook is at the root."
    }
  },
  "stylesheets": {
    "base": "@lablup/ui-common/styles/base.css",
    "dropped": "^@lablup/ui-common/styles/themes/orange-(light|dark)\\.css$",
    "layerOrder": "@layer reset, theme, base, astryx-base, astryx-theme, ui-common, components, utilities;",
    "replacement": [
      "@lablup/ui-common/reset.css",
      "@lablup/ui-common/astryx.css",
      "@lablup/ui-common/theme/lablup/theme.css",
      "@lablup/ui-common/ui-common.css",
      "@lablup/ui-common/legacy-tokens.css"
    ],
    "entryFile": "ui-common-entry.css"
  },
  "packageJson": {
    "stylex": { "name": "@stylexjs/stylex", "range": "^0.19.0" },
    "lab": { "name": "@astryxdesign/lab" }
  },
  "props": {
    "Button": {
      "variant": {
        "primary": "primary",
        "secondary": "secondary",
        "ghost": "ghost",
        "danger": "destructive",
        "text": [
          "ghost",
          "Astryx Button has no \"text\" variant; mapped to \"ghost\"."
        ],
        "outline": [
          "secondary",
          "Astryx Button has no \"outline\" variant; mapped to \"secondary\"."
        ],
        "success": [
          "primary",
          "Astryx Button has no \"success\" variant; mapped to \"primary\". Consider a success-coloured Badge beside it."
        ]
      },
      "size": { "xsmall": "sm", "small": "sm", "medium": "md", "large": "lg" },
      "rename": {
        "disabled": "isDisabled",
        "loading": "isLoading",
        "iconOnly": "isIconOnly",
        "title": "tooltip"
      },
      "todo": {
        "shape": "Astryx Button has no \"shape\". For a round icon button use IconButton, or style it in your components layer.",
        "inline": "Astryx Button has no \"inline\" variant. Use variant=\"ghost\" size=\"sm\", or a Link.",
        "active": "Astryx Button has no \"active\" state. Use ToggleButton, or aria-pressed.",
        "iconPosition": "Astryx Button renders \"icon\" before the label. A trailing icon goes in endContent as an <Icon>."
      }
    },
    "Badge": {
      "variant": {
        "default": "neutral",
        "info": "info",
        "success": "success",
        "warning": "warning",
        "danger": "error",
        "primary": [
          "orange",
          "Astryx Badge has no \"primary\" variant; mapped to the \"orange\" colour variant (tinted, not solid)."
        ]
      },
      "size": { "small": null, "medium": null }
    },
    "StatusTag": {
      "state": {
        "running": "success",
        "preparing": "accent",
        "idle": "neutral",
        "busy": "accent",
        "stopping": "warning",
        "terminated": "neutral",
        "error": "error"
      },
      "pulsingStates": ["preparing", "stopping", "busy"]
    },
    "ProgressBar": {
      "variant": {
        "primary": "accent",
        "success": "success",
        "error": "error",
        "warning": "warning"
      }
    },
    "Select": {
      "size": { "small": "sm", "default": "md", "medium": "md", "large": "lg" },
      "rename": {
        "searchable": "hasSearch",
        "noOptionsLabel": "emptyText",
        "disabled": "isDisabled"
      }
    },
    "Skeleton": {
      "variant": { "rect": null, "text": 1, "circle": "rounded" }
    },
    "Drawer": {
      "width": { "narrow": 400, "medium": 520, "wide": 900 },
      "defaultWidth": 520
    }
  }
}
